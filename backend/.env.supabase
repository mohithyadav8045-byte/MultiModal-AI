# ==============================================================================
# OmniMind AI - Dedicated Supabase Configuration
# Include all your Supabase project credentials and settings here
# ==============================================================================

# Supabase Project URL (Service URL)
# Example: https://xyzcompanyproject.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key (anon public key)
# Used for user-level interactions and RLS-enforced queries
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (secret service key)
# Used by backend to bypass RLS for administrative jobs, table setup, and storage
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Supabase PostgreSQL Database Connection URL (Transaction Pooler or Direct)
# Transaction Pooler (Port 6543): postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Direct Connection (Port 5432): postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase Storage Bucket for Multimodal Assets (PDF, DOCX, PNG, MP3, MP4)
SUPABASE_STORAGE_BUCKET=multimodal-assets


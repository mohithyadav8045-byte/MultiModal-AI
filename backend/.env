# ==============================================================================
# OmniMind AI - Backend Primary Environment (.env)
# ==============================================================================

# Server Network Configuration (Render compatible)
PORT=5000
NODE_ENV=development

# Render Web Service External URL (set in Render environment dashboard)
# RENDER_EXTERNAL_URL=https://omnimind-backend.onrender.com

# Database Connection (Supabase PostgreSQL or Local)
# Supabase Transaction Pooler: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omnidoc_ai

# Supabase Service URL & Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=multimodal-assets

# Authentication & Encryption
JWT_SECRET=super_secret_jwt_key_omnimind_production_grade_change_in_prod_2026

# Google Gemini API Key (Get at https://aistudio.google.com/)
GEMINI_API_KEY=

# File Storage Configuration
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads

# Client Origin (CORS for Vercel deployment and local dev)
CORS_ORIGIN=http://localhost:5173

{
  "name": "omnimind-ai-workspace",
  "version": "1.0.0",
  "description": "Enterprise Multimodal AI Knowledge & Operational Workspace (OmniDoc AI) - 3 Tier Architecture: Client (Vercel), Server (Render API), Backend (Supabase)",
  "scripts": {
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "server:dev": "cd server && npm run dev",
    "server:start": "cd server && npm start",
    "backend:dev": "cd backend && npm run dev",
    "backend:start": "cd backend && npm start",
    "supabase:check": "node backend/src/config/init-supabase.js",
    "setup:client": "cd client && npm install",
    "setup:server": "cd server && npm install",
    "setup:backend": "cd backend && npm install",
    "setup": "npm run setup:client && npm run setup:server && npm run setup:backend",
    "dev": "npm run backend:dev"
  },
  "keywords": [
    "multimodal",
    "gemini",
    "supabase",
    "vercel",
    "render",
    "vector-search",
    "enterprise-ai",
    "document-intelligence"
  ],
  "author": "OmniMind AI Systems",
  "license": "MIT"
}

# ==============================================================================
# OmniMind AI (OmniDoc AI) - Master Environment Template
# ==============================================================================

# Backend Port & Host
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL: Neon, Supabase, or Local PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omnidoc_ai

# Security & Session Authentication
JWT_SECRET=super_secret_jwt_key_omnimind_production_grade_change_in_prod_2026

# Google Gemini API Key
# Obtain free or enterprise key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Multimodal Ingestion Settings
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads

# Client Origin (CORS)
CORS_ORIGIN=http://localhost:5173

# Frontend API Base URL (Used in frontend/.env)
VITE_API_BASE_URL=http://localhost:5000/api


# ==============================================================================
# OmniMind Client - Environment Variables Template for Vercel
# Configure these in your Vercel Project Settings -> Environment Variables
# ==============================================================================

# Backend Render API URL
VITE_API_BASE_URL=https://your-omnimind-backend.onrender.com/api

# Supabase Project Credentials
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_SERVICE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_STORAGE_BUCKET=multimodal-assets

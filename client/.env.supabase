# ==============================================================================
# OmniMind Client - Dedicated Supabase Environment (.env.supabase)
# ==============================================================================

# Supabase Project URL (Service URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_SERVICE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (safe for public client exposure with RLS)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Storage Bucket
VITE_SUPABASE_STORAGE_BUCKET=multimodal-assets

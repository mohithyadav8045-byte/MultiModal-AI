# ==============================================================================
# OmniMind Client - Primary Environment (.env for Vercel & Local)
# ==============================================================================

# Backend API Endpoint
# In Local Dev: http://localhost:5000/api
# In Vercel Production: Point to your Render web service (e.g. https://omnimind-backend.onrender.com/api)
VITE_API_BASE_URL=http://localhost:5000/api

# Supabase Project Credentials
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_SERVICE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_STORAGE_BUCKET=multimodal-assets
